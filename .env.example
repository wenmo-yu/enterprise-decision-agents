# 多智能体经营决策平台环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# 内置 Hybrid RAG 配置
# SQLite FTS5 提供关键词/BM25 召回，OpenAI 兼容 Embedding 提供语义召回。
RAG_DB_PATH=app/data/knowledge.db
RAG_EMBEDDING_MODEL=text-embedding-v4

# 嵌入式语义问数子图：Qdrant + Elasticsearch + MySQL。
# 问数能力直接运行在本应用内，不需要配置另一个 HTTP 问数服务。
ANALYTICS_METADATA_DATABASE_URL=mysql+asyncmy://analytics_reader:change_me@localhost:3306/analytics_meta
ANALYTICS_WAREHOUSE_DATABASE_URL=mysql+asyncmy://analytics_reader:change_me@localhost:3306/analytics_dw
ANALYTICS_QDRANT_URL=http://localhost:6333
ANALYTICS_ELASTICSEARCH_URL=http://localhost:9200
ANALYTICS_COLUMN_COLLECTION=analytics_columns
ANALYTICS_METRIC_COLLECTION=analytics_metrics
ANALYTICS_VALUE_INDEX=analytics_values
ANALYTICS_EMBEDDING_MODEL=text-embedding-v4
# 可选 Cross-Encoder 服务。未配置时保留 Dense 召回顺序。
ANALYTICS_RERANKER_URL=
ANALYTICS_MAX_ROWS=1000
ANALYTICS_TIMEOUT_SECONDS=15

# Context Engineering：程序级限制专家调用、可回传上下文与一次任务的总时限。
# token 为保守估算，用于预算控制而非供应商账单；完整工具产物写入 output/session_*/artifacts。
AGENT_MAX_EXPERT_CALLS=8
AGENT_MAX_CONTEXT_TOKENS=12000
AGENT_MAX_WALL_TIME_SECONDS=180
